{
  "name": "rag-scrape",
  "version": "1.0.0",
  "description": "Convert any URL to clean Markdown from the terminal",
  "keywords": [
    "markdown",
    "scraper",
    "url-to-markdown",
    "rag",
    "cli",
    "llm"
  ],
  "author": "RagScrape",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragscrape/rag-scrape"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rag-scrape": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
